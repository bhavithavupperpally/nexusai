# ============================================================================
# PDF-ChatGPT - environment configuration
# Copy this file to ".env" and fill in your own values.
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
# ============================================================================

# --- Application -----------------------------------------------------------
APP_NAME=PDF-ChatGPT
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true

# --- Server ------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Comma-separated list of allowed origins, or "*" for all (dev only).
CORS_ORIGINS=*

# --- Embeddings (Local or Gemini) ------------------------------------------
# Set to "local" (recommended: 100% free, offline, zero API quota, handles 1000+ chunks)
# or "gemini" to use Google GenAI embedding API.
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Google Gemini (for Chat Answer Generation) -----------------------------
# Get your free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_REQUEST_TIMEOUT=60
GEMINI_MAX_OUTPUT_TOKENS=1024

# --- Optional legacy fallback (if using OpenAI instead) --------------------
# OPENAI_API_KEY=sk-your-openai-api-key-here

# --- RAG pipeline --------------------------------------------------------
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=4
MAX_UPLOAD_MB=25

# --- Storage -------------------------------------------------------------
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
VECTOR_STORE_DIR=./data/vector_store
DATABASE_URL=sqlite:///./data/app.db
LOG_DIR=./logs
LOG_LEVEL=INFO
